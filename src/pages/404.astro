---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — My Lab Tests"
  description="That page doesn't exist. Head back to the comparisons."
  path="/404/"
>
  <div class="py-16 text-center">
    <h1 class="text-3xl font-extrabold">Nothing at this address</h1>
    <p class="mt-3 text-ink-soft">
      The page may have moved when data was refreshed, or the link had a typo.
    </p>
    <a href="/" class="btn-primary mt-6">Back to all comparisons</a>
  </div>
</BaseLayout>
