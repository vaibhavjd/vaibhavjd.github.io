---
import type { Crumb } from '@lib/seo';

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-4 pt-3 text-sm text-ink-soft">
  <ol class="flex flex-wrap items-center gap-1">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">›</span>}
        {i < crumbs.length - 1 ? (
          <a href={c.path} class="text-navy hover:underline">{c.name}</a>
        ) : (
          <span aria-current="page">{c.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
