---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<div class="flex items-start gap-3 rounded-xl bg-sand px-4 py-3.5">
  <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="mt-0.5 shrink-0">
    <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.3" class="text-ink-soft" />
    <line x1="8" y1="7" x2="8" y2="11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="text-ink-soft" />
    <circle cx="8" cy="4.6" r="0.9" fill="currentColor" class="text-ink-soft" />
  </svg>
  <p class="m-0 text-[12.5px] leading-relaxed text-ink-soft">
    <strong class="font-semibold text-ink">Medical disclaimer.</strong> {text}
  </p>
</div>
