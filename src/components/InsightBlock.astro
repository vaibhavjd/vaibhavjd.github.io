---
// Computed, data-derived summary. Regenerates with every publish, so the
// facts on each page are genuinely that city's facts.
import type { TestCityInsights } from '@lib/data';
import { formatINR, formatTat } from '@lib/format';

interface Props {
  insights: TestCityInsights;
  label: string;
  cityName: string;
}
const { insights: s, label, cityName } = Astro.props;
---

<div class="card bg-navy-100/50">
  <p class="leading-relaxed">
    {label} in {cityName} costs
    <strong class="num">{formatINR(s.min)}–{formatINR(s.max)}</strong> across
    {s.n} labs right now. Cheapest all-in: <strong>{s.cheapest.provider.name}</strong>
    at <strong class="num">{formatINR(s.cheapest.total)}</strong>{s.cheapest.appliedCollectionFee === 0 && ', with a free home visit'}.
    {s.cheapestNabl && s.cheapestNabl.offer.id !== s.cheapest.offer.id && (
      <>
        Cheapest NABL-accredited option: {s.cheapestNabl.provider.name} at
        <strong class="num"> {formatINR(s.cheapestNabl.total)}</strong>.
      </>
    )}
    Fastest report: {s.fastest.provider.name} in {formatTat(s.fastest.offer.tat_hours)}.
    {s.freeCollectionCount > 0 && (
      <>{s.freeCollectionCount} of {s.n} labs collect your sample at home for free.</>
    )}
  </p>
</div>
