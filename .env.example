# Absolute origin for canonicals/sitemaps/JSON-LD. Flip at domain cutover.
PUBLIC_SITE_URL=https://mylabtests.github.io

# "true" while staging: noindex meta, robots.txt disallow, sample-data banner
# behaviour tied to data_mode. Set "false" at go-live.
PUBLIC_STAGING=true

# Google Tag Manager container id (GTM-XXXXXXX). GTM/GA4 snippets render only
# when this is set.
PUBLIC_GTM_ID=

# Search-console verification tokens. Meta tags render only when set.
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=
